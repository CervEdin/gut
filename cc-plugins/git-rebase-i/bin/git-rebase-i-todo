#!/bin/sh
#
# git-rebase-i-todo — edit a rebase todo list by commit, not by text
#
# usage: GIT_SEQUENCE_EDITOR="git rebase-i-todo [--no-break] [<action>...]" \
#        git rebase -i <base>
#
# git appends the todo file as the last argument.  Each action names a
# commit by any revision; it is resolved with rev-parse before the todo
# is touched, and the todo line is found by comparing the full sha with
# the abbreviated one git wrote.  An action whose commit has no todo
# line fails the whole edit, so the rebase never starts on the wrong
# commit.
#
#   drop=<rev>             drop the commit
#   edit=<rev>             stop after the commit is applied
#   fixup=<rev>:<target>   move <rev> right after <target> and fold it in,
#                          keeping <target>'s message
#   squash=<rev>:<target>  the same, combining the two messages
#   move=<rev>:<target>    move <rev> right after <target> (reorder)
#
# A move that would cross a label, reset or merge line fails: that is a
# topology change, and the todo has to be written by hand for it.
#
# The todo ends with `break`, so the rebase pauses with the new history
# on a detached HEAD and the branch still where it was.  There
# `git rebase-i-check` reports the result; `git rebase --continue` then
# moves the branch, and `git rebase --abort` undoes everything.
# --no-break leaves it out.  With no action at all, only the break is
# added, which is what an autosquash run needs.
#
# On success the changed lines are printed on stderr, one per action.

set -eu

usage() {
	sed -n '2,/^$/{s/^# \{0,1\}//;p;}' "$0" >&2
	exit 1
}

die() {
	echo "git rebase-i-todo: $*" >&2
	exit 1
}

test $# -ge 1 || usage

addbreak=1
if test "$1" = --no-break; then
	addbreak=0
	shift
fi

actions=$(git rev-parse --git-path rebase-i-todo-actions)
cleanup() {
	test -f "$actions" && rm "$actions"
	return 0
}
trap cleanup EXIT
: >"$actions"

resolve() {
	git rev-parse --verify --quiet "$1^{commit}" || die "not a commit: $1"
}

n=$#
i=0
todo=
for arg; do
	i=$((i + 1))
	if test $i -eq $n; then
		todo=$arg
		break
	fi
	case "$arg" in
	drop=?* | edit=?*)
		act=${arg%%=*}
		rev=${arg#*=}
		target=
		;;
	fixup=?*:?* | squash=?*:?* | move=?*:?*)
		act=${arg%%=*}
		rest=${arg#*=}
		rev=${rest%%:*}
		target=${rest#*:}
		;;
	*)
		die "unknown action: $arg"
		;;
	esac
	sha=$(resolve "$rev")
	tsha=
	test -z "$target" || tsha=$(resolve "$target")
	test "$sha" != "$tsha" || die "$rev and $target are the same commit"
	printf '%s %s %s %s %s\n' "$act" "$sha" "${tsha:--}" "$rev" "${target:--}" >>"$actions"
done
test -f "$todo" || die "no todo file: $todo"

# The todo is rewritten only when every action applied.
new=$(awk -v addbreak="$addbreak" '
function fail(msg) {
	printf "git rebase-i-todo: %s\n", msg >"/dev/stderr"
	exit 1
}
# The todo line of a commit, by full sha; 0 if none.
function find(full, what,	i) {
	for (i = 1; i <= n; i++)
		if (sha[i] != "" && index(full, sha[i]) == 1)
			return i
	for (i = 1; i <= n; i++)
		if (msha[i] != "" && index(full, msha[i]) == 1)
			fail(what " is a merge commit: " line[i] "\n  (write the todo by hand)")
	return 0
}
function setcmd(i, c) {
	sub(/^[a-z]+/, c, line[i])
}
function posof(li,	k) {
	for (k = 1; k <= len; k++)
		if (order[k] == li)
			return k
}
# Move line li to just after position q, refusing to cross a
# topology line.
function moveafter(li, q, what,	p, k, lo, hi, tmp) {
	p = posof(li)
	lo = (p < q) ? p + 1 : q + 1
	hi = (p < q) ? q : p - 1
	for (k = lo; k <= hi; k++)
		if (boundary[order[k]])
			fail("moving " what " would cross \"" line[order[k]] "\"\n  (a topology change; write the todo by hand)")
	tmp = order[p]
	if (p < q) {
		for (k = p; k < q; k++)
			order[k] = order[k + 1]
		order[q] = tmp
	} else {
		for (k = p; k > q + 1; k--)
			order[k] = order[k - 1]
		order[q + 1] = tmp
	}
}
FILENAME == ARGV[1] {
	na++
	act[na] = $1; rev[na] = $2; tgt[na] = $3; revname[na] = $4; tgtname[na] = $5
	next
}
{
	n++
	line[n] = $0
	cmd[n] = $1
	sha[n] = ""; msha[n] = ""; boundary[n] = 0; upd[n] = 0
	if (cmd[n] ~ /^(pick|p|reword|r|edit|e|squash|s|drop|d)$/)
		sha[n] = $2
	else if (cmd[n] ~ /^(fixup|f)$/)
		sha[n] = ($2 ~ /^-[Cc]$/) ? $3 : $2
	else if (cmd[n] ~ /^(merge|m)$/) {
		boundary[n] = 1
		if ($2 ~ /^-[Cc]$/)
			msha[n] = $3
	} else if (cmd[n] ~ /^(label|l|reset|t)$/)
		boundary[n] = 1
	else if (cmd[n] ~ /^(update-ref|u)$/)
		upd[n] = 1
}
END {
	if (n == 0)
		fail("empty todo")
	len = n
	for (k = 1; k <= n; k++)
		order[k] = k
	for (a = 1; a <= na; a++) {
		li = find(rev[a], revname[a])
		if (!li)
			fail("no todo line for " revname[a] " (" substr(rev[a], 1, 7) ")")
		if (act[a] == "drop" || act[a] == "edit") {
			setcmd(li, act[a])
			changed[++nc] = li
			continue
		}
		ti = find(tgt[a], tgtname[a])
		if (!ti)
			fail("no todo line for " tgtname[a] " (" substr(tgt[a], 1, 7) ")")
		q = posof(ti)
		# A reorder stays outside the branch marker that follows the
		# target; a fold becomes part of the target, so it goes before it.
		if (act[a] == "move")
			while (q < len && upd[order[q + 1]])
				q++
		moveafter(li, q, revname[a])
		if (act[a] != "move")
			setcmd(li, act[a])
		changed[++nc] = li
		after[li] = ti
	}
	last = ""
	for (k = 1; k <= len; k++) {
		print line[order[k]]
		if (line[order[k]] !~ /^(#|$)/)
			last = cmd[order[k]]
	}
	if (addbreak && last != "break" && last != "b") {
		print "break"
		changed[++nc] = 0
		line[0] = "break"
	}
	for (c = 1; c <= nc; c++) {
		li = changed[c]
		msg = "git rebase-i-todo: " line[li]
		if (after[li])
			msg = msg "  (after " sha[after[li]] ")"
		print msg >"/dev/stderr"
	}
}
' "$actions" "$todo") || exit 1
printf '%s\n' "$new" >"$todo"
