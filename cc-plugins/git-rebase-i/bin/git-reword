#!/bin/sh
#
# git-reword — create an amend! commit for `git rebase --autosquash`
#
# usage: git reword <commit> (-m <message>... | -F <file>)
#
# The new message becomes the body of an "amend! <sha>" commit, which
# `git rebase -i --autosquash` folds into <commit>, replacing its
# message.  Naming the target by sha rather than by subject keeps
# autosquash from pairing the amend! with an older commit that has
# the same subject.
#
# Only HEAD's tree is committed (`git commit --only`), so staged
# changes stay in the index and do not end up inside the old commit.
# Several -m are joined as paragraphs, as `git commit` joins them.
# `-F -` reads the message from stdin.

set -eu

usage() {
	echo "usage: git reword <commit> (-m <message>... | -F <file>)" >&2
	exit 1
}

die() {
	echo "git reword: $*" >&2
	exit 1
}

test $# -ge 3 || usage
commit=$1
shift

# Keep scratch files in the git dir, never in the work tree.
msg=$(git rev-parse --git-path reword-msg)
full=$(git rev-parse --git-path reword-full)
cleanup() {
	for f in "$msg" "$full"; do
		test -f "$f" && rm "$f"
	done
	return 0
}
trap cleanup EXIT

: >"$msg"
source=
while test $# -gt 0; do
	case "$1" in
	-m)
		test $# -ge 2 || usage
		test "$source" != -F || die "-m and -F cannot be combined"
		source=-m
		test ! -s "$msg" || printf '\n' >>"$msg"
		printf '%s\n' "$2" >>"$msg"
		shift 2
		;;
	-F)
		test $# -ge 2 || usage
		test -z "$source" || die "-F cannot be combined with -m or another -F"
		source=-F
		if test "$2" = -; then
			cat >"$msg"
		else
			cat "$2" >"$msg"
		fi
		shift 2
		;;
	*)
		usage
		;;
	esac
done
test -n "$source" || usage

sha=$(git rev-parse --verify --quiet "$commit^{commit}") ||
	die "not a commit: $commit"
git merge-base --is-ancestor "$sha" HEAD ||
	die "$commit is not an ancestor of HEAD; autosquash would never reach it"

# Refuse an empty message before anything is committed.
git stripspace <"$msg" | grep -q . ||
	die "empty message; nothing committed"

{
	printf 'amend! %s\n\n' "$sha"
	git stripspace <"$msg"
} >"$full"

git commit --quiet --allow-empty --only -F "$full"
printf 'amend! %s -> %s %s\n' \
	"$(git rev-parse --short HEAD)" \
	"$(git rev-parse --short "$sha")" \
	"$(git log -1 --format=%s "$sha")"
