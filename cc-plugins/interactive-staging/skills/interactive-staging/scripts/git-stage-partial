#!/bin/bash
# git-stage-partial: stage a constructed file version into the index
# Usage: git-stage-partial <path> <tempfile>
#        git-stage-partial --remove <path>
#
# <path> is relative to the current directory, or absolute, as for other
# git commands.

# Print the index name of <path>. The remaining arguments say where to
# look: --cached for the index, --others for untracked files. Prints
# nothing when <path> is in neither.
resolve() {
  local path=$1 name
  shift
  # A pathspec also matches everything below a directory of that name.
  if [ -d "$path" ] ||
    [ -n "$(git --literal-pathspecs ls-files --cached -- "$path/")" ]; then
    echo "error: $path: is a directory" >&2
    return 1
  fi
  # An unmerged path has one entry per stage; --deduplicate lists it once.
  IFS= read -r -d '' name < <(git --literal-pathspecs ls-files -z \
    --deduplicate --full-name "$@" -- "$path")
  printf '%s' "$name"
}

if [ "${1:-}" = "--remove" ]; then
  path="${2:?Usage: git-stage-partial --remove <path>}"
  name=$(resolve "$path" --cached) || exit 1
  if [ -z "$name" ]; then
    echo "error: $path: not in the index (cwd: $PWD)" >&2
    exit 1
  fi
  git update-index --force-remove -- "$path"
  exit
fi

path="${1:?Usage: git-stage-partial <path> <tempfile>}"
tempfile="${2:?Usage: git-stage-partial <path> <tempfile>}"

name=$(resolve "$path" --cached --others) || exit 1
if [ -z "$name" ]; then
  echo "error: $path: not in the index or the work tree (cwd: $PWD)" >&2
  exit 1
fi

# Detect file mode: prefer index entry, fall back to filesystem
mode=$(git --literal-pathspecs ls-files --stage -- "$path" |
  awk '{print $1; exit}')
if [ -z "$mode" ]; then
  # New file — detect from filesystem permissions
  if [ -x "$path" ]; then
    mode=100755
  else
    mode=100644
  fi
fi

sha=$(git hash-object -w -- "$tempfile") || {
  echo "error: git hash-object failed for $tempfile" >&2
  exit 1
}

# --cacheinfo takes the name relative to the top of the work tree.
git update-index --add --cacheinfo "$mode,$sha,$name"
